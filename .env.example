# NyayaAI Environment Configuration Template
# Copy this file to .env and set your secrets. DO NOT commit .env to version control.

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000

# Google Gemini API Key (Optional - system automatically falls back to offline deterministic grounded mode if omitted)
GEMINI_API_KEY=

# Security & Safety Thresholds
MAX_INPUT_LENGTH=4000
MAX_FILE_SIZE_MB=2.0
RATE_LIMIT_PER_MINUTE=60

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
